# ==============================================================================
# VARSHAAI — Backend Environment Variables Configuration Template
# SIH 26080: Regime-Aware AI Post-Processing of Monsoon Rainfall Forecasts
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (e.g. cp .env.example .env)
# 2. Add your credentials (never commit the actual .env file to Git)
# 3. On cloud platforms (Render, Railway, Fly.io), set these in the Dashboard Environment Variables.

# Environment Mode
ENVIRONMENT=production

# Server Network Configuration (Render/Railway automatically assign PORT)
PORT=8000
HOST=0.0.0.0

# Public Production URLs
BACKEND_URL=https://your-backend-app.onrender.com
FRONTEND_URL=https://your-frontend-app.vercel.app

# Live Meteorological APIs
# Open-Meteo: Completely free, no API key required, full CORS support
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Tomorrow.io Weather API (Optional: server-side only, never exposed to browser)
TOMORROW_API_KEY=
TOMORROW_API_BASE_URL=https://api.tomorrow.io/v4

# OpenWeatherMap API (Optional: server-side only, never exposed to browser)
OPENWEATHER_API_KEY=

# CORS Configuration (comma-separated origins, e.g. https://varshaai.vercel.app,https://yourdomain.com)
CORS_ORIGINS=

# Model and Dataset Paths (leave commented to use default project paths)
# MODEL_PATH=backend/models
# DATASET_PATH=backend/data/SIH26080_10000_training_dataset.csv
