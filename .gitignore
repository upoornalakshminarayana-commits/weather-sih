# VARSHAAI — Git Ignore Rules

# Local API keys and environment configurations (DO NOT COMMIT SECRETS)
js/config.js
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
*.pem
*.key

# Python Backend & Virtual Environments
backend/.venv/
backend/venv/
.venv/
venv/
backend/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Node / Frontend temporary files
node_modules/
npm-debug.log*

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local temporary logs
*.log
scratch/
